<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="lab_record" model="sentry.error.lab">
        <field name="name">Sentry Error Lab</field>
    </record>
    <record id="poison_record" model="sentry.error.lab.poison">
        <field name="name">Poisoned record (reading it fails while the lab is armed)</field>
    </record>
    <!-- never runs on schedule: it is fired on demand with _trigger() -->
    <record id="cron_error_lab" model="ir.cron">
        <field name="name">Sentry Error Lab: deliberate failure</field>
        <field name="model_id" ref="model_sentry_error_lab"/>
        <field name="state">code</field>
        <field name="code">model._cron_boom()</field>
        <field name="interval_number">1200</field>
        <field name="interval_type">months</field>
        <field name="nextcall">2099-01-01 00:00:00</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
